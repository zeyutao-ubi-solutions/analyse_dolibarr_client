# Copy to .env. Do not commit .env or *.p8.
# Read-only access to the Dolibarr marts (same account as internal-agent-hub/snowflake-mcp).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=UBI_DATAHUB_TEST
SNOWFLAKE_SCHEMA=DBT__3_MARTS

# Absolute path to the PKCS8 private key (.p8)
SNOWFLAKE_PRIVATE_KEY_PATH=
# Leave empty if the key has no passphrase
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
